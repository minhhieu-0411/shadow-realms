<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Shadow Realms{% endblock %}</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    
    <style>
        body {
            background: linear-gradient(to bottom, #1a0033, #0f0022);
            color: #ffdd99;
            min-height: 100vh;
            font-family: 'Georgia', serif;
        }
        .navbar {
            background: linear-gradient(#330066, #1a0033) !important;
            border-bottom: 4px solid #ffcc00;
        }
        .card {
            background: #2a0044;
            border: 2px solid #ffcc00;
            color: #ffdd99;
        }
        .btn-warning {
            background: #ffcc00;
            color: #330066;
            font-weight: bold;
        }
        .nav-link {
            color: #ffdd99 !important;
        }
        .nav-link:hover {
            color: #ffcc00 !important;
        }
        .navbar-text {
            font-weight: bold;
        }
    </style>
</head>
<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold text-warning" href="{{ path('app_player_dashboard') }}">
                <i class="fas fa-dragon"></i> Shadow Realms
            </a>
            
            <div class="navbar-nav ms-auto">
                {% if app.user %}
                    <span class="navbar-text me-4">
                        <i class="fas fa-coins text-warning"></i> {{ app.user.player.gold | default(0) }} Gold
                    </span>
                    
                    <a class="nav-link" href="{{ path('app_player_dashboard') }}">Dashboard</a>
                    <a class="nav-link" href="{{path('app_quest_index')}}">Quests</a>
                    <a class="nav-link" href="{{path('app_battle_encounter')}}">Battle</a>
                    <a class="nav-link" href="#">Inventory</a>
                    <a class="nav-link" href="#">Shop</a>
                    
                    <a class="nav-link text-danger ms-3" href="{{ path('app_logout') }}">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                {% else %}
                    <a class="nav-link" href="{{ path('app_register') }}">Register</a>
                    <a class="nav-link" href="{{ path('app_login') }}">Login</a>
                {% endif %}
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        {% block body %}{% endblock %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>