{% extends 'base.html.twig' %}

{% block title %}Edit Profile{% endblock %}

{% block body %}
<div class="container">
    <div class="card">
        <div class="card-header text-warning">
            <h3>Edit Character</h3>
        </div>

        <div class="card-body">

            <form method="post">

                <!-- Editable name -->
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input 
                        type="text" 
                        name="name" 
                        value="{{ player.name }}" 
                        class="form-control"
                        required
                    >
                </div><div class="mb-3">
                    <label class="form-label">attack</label>
                    <input 
                        type="number" 
                        name="attack" 
                        value="{{ player.attack }}" 
                        class="form-control"
                        required
                    >
                </div>

                <!-- Read-only stats -->
                <p><strong>Level:</strong> {{ player.level }}</p>
                <p><strong>HP:</strong> {{ player.health }} / {{ player.maxHealth }}</p>
                <p><strong>Defense:</strong> {{ player.defense }}</p>
                <p><strong>Gold:</strong> {{ player.gold }}</p>

                <button class="btn btn-warning mt-3">Save</button>
            </form>

        </div>

        <div class="card-footer">
            <a href="{{ path('app_player_profile') }}" class="btn btn-secondary">
                Back
            </a>
        </div>
    </div>
</div>
{% endblock %}