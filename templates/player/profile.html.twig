{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}
<div class="container">
    <div class="card">
        <div class="card-header text-warning">
            <h3>{{ player.name }}</h3>
        </div>

        <div class="card-body">
            <p><strong>Level:</strong> {{ player.level }}</p>
            <p><strong>HP:</strong> {{ player.health }} / {{ player.maxHealth }}</p>
            <p><strong>Attack:</strong> {{ player.attack }}</p>
            <p><strong>Defense:</strong> {{ player.defense }}</p>
            <p><strong>Gold:</strong> {{ player.gold }}</p>
        </div>

        <div class="card-footer">
            <a href="{{ path('app_player_edit') }}" class="btn btn-warning">
                Edit Name
            </a>
        </div>
    </div>
</div>
{% endblock %}